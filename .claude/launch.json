{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "src/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["src/api/dev.py"],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/web", "run", "dev"],
      "port": 3000
    }
  ]
}
